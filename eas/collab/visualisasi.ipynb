       "                                              &lt;div style=&quot;font-size:9px; color:#b2bec3; font-weight:500; text-transform:none; margin-top:2px;&quot;&gt;${infoText}&lt;/div&gt;`;\n",
       "\n",
       "                        groupDiv.appendChild(titleDiv);\n",
       "\n",
       "                        const ulElement = document.createElement(&#x27;ul&#x27;);\n",
